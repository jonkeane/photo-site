{{/*
Content adapter: one Hugo page per photo, with the same layouts and taxonomies.
R2 galleries normalize into the existing photoset shape at build time.
*/}}

{{ $sets := newScratch }}
{{ $sets.Set "photosets" dict }}
{{ range $slug, $photoset := site.Data.flickr.photosets }}
  {{ $sets.SetInMap "photosets" $slug $photoset }}
{{ end }}
{{ range $slug, $m := site.Data.r2.galleries }}
    {{ if ne (int $m.schemaVersion) 1 }}
      {{ errorf "R2 gallery %s has an unsupported or mismatched manifest; run r2import" $slug }}
    {{ end }}
    {{ $photos := slice }}
    {{ range $p := $m.entries }}
      {{ $thumbnail := $p.source }}
      {{ $thumbnailWidth := $p.width }}
      {{ $thumbnailHeight := $p.height }}
      {{ $gallery := $p.source }}
      {{ $galleryWidth := $p.width }}
      {{ $galleryHeight := $p.height }}
      {{ with $p.renditions }}
        {{ $thumbnail = .thumbnail.source }}
        {{ $thumbnailWidth = .thumbnail.width }}
        {{ $thumbnailHeight = .thumbnail.height }}
        {{ $gallery = .gallery.source }}
        {{ $galleryWidth = .gallery.width }}
        {{ $galleryHeight = .gallery.height }}
      {{ end }}
      {{ $photos = $photos | append (dict
        "id" $p.id "title" $p.title "description" (dict "_content" ($p.caption | default ""))
        "tags" ($p.tags | default slice) "datetaken" $p.dateTaken "dateupload" $p.dateUpload
        "lastupdate" $p.lastUpdate "ownername" $p.ownerName "license" $p.license
        "exif" ($p.exif | default dict) "copyright" $p.copyright "alt" $p.alt
        "url_sq" $thumbnail "url_t" $thumbnail "url_s" $thumbnail "url_n" $thumbnail
        "url_m" $gallery "url_z" $gallery "url_c" $gallery "url_l" $p.source
        "url_h" $p.source "url_k" $p.source "url_o" $p.source
        "width_sq" $thumbnailWidth "height_sq" $thumbnailHeight
        "width_t" $thumbnailWidth "height_t" $thumbnailHeight
        "width_s" $thumbnailWidth "height_s" $thumbnailHeight
        "width_n" $thumbnailWidth "height_n" $thumbnailHeight
        "width_m" $galleryWidth "height_m" $galleryHeight
        "width_z" $galleryWidth "height_z" $galleryHeight
        "width_c" $galleryWidth "height_c" $galleryHeight
        "width_l" $p.width "height_l" $p.height
        "width_h" $p.width "height_h" $p.height
        "width_k" $p.width "height_k" $p.height
        "width_o" $p.width "height_o" $p.height
        "image_width" $p.width "image_height" $p.height "image_renditions" $p.renditions
        "social_image" $gallery
      ) }}
    {{ end }}
    {{ $sets.SetInMap "photosets" $slug (dict "provider" "r2" "photoset" (dict "id" $m.galleryId "photo" $photos)) }}
{{ end }}
{{ $photosets := $sets.Get "photosets" }}
{{ if not $photosets }}
  {{ warnf "gallery adapter: no photosets found in site.Data.flickr.photosets" }}
{{ else }}
  {{ range $slug, $ps := $photosets }}
    {{ if and (not ($ps.photoset.photo)) (ne $ps.provider "r2") }}
      {{ warnf "gallery adapter: photoset %q missing photo array" $slug }}
    {{ else }}
      {{ $setID := $ps.photoset.id }}
      {{ $sortedPhotos := sort $ps.photoset.photo "datetaken" }}
      {{ $cover := partial "gallerys/cover-entry" (dict "photos" $sortedPhotos "slug" $slug) }}
      {{ $photoSlugs := dict }}
      {{ if eq $ps.provider "r2" }}
        {{ $photoSlugs = partial "gallerys/photo-slugs" (dict "photos" $sortedPhotos "cover" $cover) }}
      {{ end }}
      {{ range $p := $sortedPhotos }}
        {{ $fid := string $p.id }}
          {{ $tags := $p.tags }}
          {{ $make := string ($p.exif.make | default "") }}
          {{ if eq (lower (strings.TrimSpace $make)) "noritsu koki" }}
            {{ $make = "" }}
          {{ end }}
          {{ $model := string ($p.exif.model | default "") }}
          {{ $camera := $model }}
          {{ $emulsion := strings.TrimSpace ($p.exif.emulsion | default "") }}
          {{ if not $emulsion }}
          {{ range site.Params.emulsions }}
            {{ $emulsionName := . }}
            {{ if hasPrefix $camera $emulsionName }}
              {{ $emulsion = $emulsionName }}
              {{ $camera = strings.TrimPrefix $emulsionName $camera }}
              {{ $camera = strings.TrimSpace $camera }}
              {{ $isoStr := string $p.exif.iso }}
              {{ if not (in $emulsion $isoStr) }}
                {{ $emulsion = printf "%s %s" $emulsion $isoStr }}
              {{ end }}
              {{ $emulsion = replace $emulsion "Fuji " "Fujifilm "}}
              {{ $emulsion = replace $emulsion "Fujichrome " ""}}
              {{ $emulsion = replace $emulsion "Fujicolor " ""}}
              
              {{ if eq $emulsion "Fujifilm Pro 400H" }} {{ $emulsion = "Fujifilm Pro H 400" }} {{ end }}
              {{ if eq $emulsion "Fujifilm Provia 100" }} {{ $emulsion = "Fujifilm Provia F 100" }} {{ end }}
              {{ if eq $emulsion "Fujifilm Provia 100F" }} {{ $emulsion = "Fujifilm Provia F 100" }} {{ end }}
              {{ if eq $emulsion "Kodak Ektachrome E 100" }} {{ $emulsion = "Kodak Ektachrome E100" }} {{ end }}
              {{ if eq $emulsion "Kodak E100" }} {{ $emulsion = "Kodak Ektachrome E100" }} {{ end }}
              {{ if eq $emulsion "Kodak E100" }} {{ $emulsion = "Kodak Ektachrome E100" }} {{ end }}
              {{ if eq $emulsion "CatLABS X FILM 100" }} {{ $emulsion = "CatLABS  X 100" }} {{ end }}
            {{ end }}
          {{ end }}
          {{ end }}
          {{ if and $make (not $emulsion) (not (in $camera $make)) }}
            {{ if $camera }}
              {{ $camera = printf "%s %s" $make $camera }}
            {{ else }}
              {{ $camera = $make }}
            {{ end }}
          {{ end }}
          {{ $lens := $p.exif.lens }}
          {{ $lens = strings.Replace $lens "back triple camera" "back" }}
          {{ $lens = strings.Replace $lens "back camera" "back" }}
          {{ $lens = strings.Replace $lens "back dual wide camera" "back" }}
          {{ $lens = strings.Replace $lens "front camera" "front" }}
          {{ $lens = strings.Replace $lens "Carl Zeiss" "Zeiss" }}

          {{ if eq $lens "Zeiss Planar 80mm f/2.8 CF" }} {{ $lens = "Zeiss Planar CF 80mm F/2.8" }} {{ end }}
          {{ if eq $lens "Zeiss Distagon 40mm f/4 CF FLE" }} {{ $lens = "Zeiss Distagon CF FLE 40mm f/4" }} {{ end }}
          {{ if eq $lens "Zeiss Distagon 60mm f/3.5 CF" }} {{ $lens = "Zeiss Distagon CF 60mm f/3.5" }} {{ end }}

          {{ if eq $lens "28.0-135.0 mm" }} {{ $lens = "EF 28-135mm" }} {{ end }}
          {{ if eq $lens "10.0-22.0 mm" }} {{ $lens = "EF-S 10-22mm" }} {{ end }}
          {{ if eq $lens "90.0 mm" }} {{ $lens = "Tamron SP 90mm" }} {{ end }}

          {{ $exif := $p.exif | default dict }}
          {{ $fstop := string ($exif.fstop | default "") }}
          {{ if strings.HasSuffix $fstop ".0" }}
            {{ $fstop = strings.TrimSuffix ".0" $fstop }}
          {{ end }}
          {{ $exposure := string ($exif.exposure | default "") }}
          {{ if eq $exposure "0.5" }}
            {{ $exposure = "1/2" }}
          {{ else if eq $exposure "0.3" }}
            {{ $exposure = "1/3" }}
          {{ else if strings.HasSuffix $exposure ".0" }}
            {{ $exposure = strings.TrimSuffix ".0" $exposure }}
          {{ end }}
          {{ if or (ne $fstop ($exif.fstop | default "")) (ne $exposure ($exif.exposure | default "")) }}
            {{ $exif = merge $exif (dict "fstop" $fstop "exposure" $exposure) }}
          {{ end }}

          {{ if and (ne $p.id $cover.id) (not (in $tags "nogallery")) }}
            {{ $content := dict "mediaType" "text/markdown" "value" "" }}
            {{ $dates := dict }}
            {{ with $p.datetaken }}{{ $dates = dict "date" (time.AsTime .) }}{{ end }}
            {{ $photoTitle := $p.title | default "untitled" }}
            {{ $lowerTitle := lower $photoTitle }}
            {{ if or (strings.HasSuffix $lowerTitle ".jpg") (strings.HasSuffix $lowerTitle ".jpeg") (strings.HasSuffix $lowerTitle ".png") (strings.HasSuffix $lowerTitle ".tiff") (strings.HasSuffix $lowerTitle ".tif") (strings.HasSuffix $lowerTitle ".gif") (strings.HasSuffix $lowerTitle ".bmp") (strings.HasSuffix $lowerTitle ".webp") (strings.HasSuffix $lowerTitle ".heif") (strings.HasSuffix $lowerTitle ".heic") (strings.HasSuffix $lowerTitle ".arw") (strings.HasSuffix $lowerTitle ".cr2") (strings.HasSuffix $lowerTitle ".cr3") (strings.HasSuffix $lowerTitle ".dng") (strings.HasSuffix $lowerTitle ".nef") (strings.HasSuffix $lowerTitle ".orf") (strings.HasSuffix $lowerTitle ".raf") (strings.HasSuffix $lowerTitle ".rw2") }}
              {{ $photoTitle = "untitled" }}
            {{ end }}
            {{ $params := dict
                "photo_id" $fid
                "album_id" $setID
                "storage_provider" ($ps.provider | default "flickr")
                "gallery_slug" $slug
                "tags" $tags
                "cameras" $camera
                "lenses" $lens
                "emulsions" $emulsion
                "datetaken" $p.datetaken
                "dateupload" $p.dateupload
                "description" $p.description
                "exif" $exif
                "last_update" $p.lastupdate
                "license" $p.license
                "ownername" $p.ownername
                "title" $p.title
                "alt" $p.alt
                "copyright" $p.copyright
                "image_width" $p.image_width "image_height" $p.image_height
                "image_renditions" $p.image_renditions "social_image" $p.social_image
                "url_c" $p.url_c
                "url_h" $p.url_h
                "url_k" $p.url_k
                "url_l" $p.url_l
                "url_m" $p.url_m
                "url_n" $p.url_n
                "url_o" $p.url_o
                "url_s" $p.url_s
                "url_sq" $p.url_sq
                "url_t" $p.url_t
                "url_z" $p.url_z
              }}
            {{/* Keep each rendition's dimensions alongside its URL. Old caches may omit them. */}}
            {{ range $size := slice "sq" "t" "s" "n" "m" "z" "c" "l" "h" "k" "o" }}
              {{ range $axis := slice "width" "height" }}
                {{ $key := printf "%s_%s" $axis $size }}
                {{ with index $p $key }}
                  {{ $params = merge $params (dict $key .) }}
                {{ end }}
              {{ end }}
            {{ end }}
            {{ if ne $ps.provider "r2" }}
              {{ $params = merge $params (dict "flickr_id" $fid "flickr_album" $setID) }}
            {{ end }}
            {{ $photoSlug := index $photoSlugs $fid | default $fid }}
            {{ $page := dict
                "content" $content
                "dates" $dates
                "kind" "page"
                "path" (printf "%s/%s" $slug $photoSlug)
                "title" $photoTitle
                "type" "gallery"
                "layout" "single"
                "params" $params
              }}
            {{ $.AddPage $page }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
